{
  "name": "delivery-dashboard-ui",
  "version": "1.0.0",
  "scripts": {
    "ng": "ng",
    "start": "npm cache clean --force & ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "serve:ssr:generic-dashbord": "node dist/generic-dashbord/server/server.mjs",
    "start:local": "npm run ds-api && ng serve -- --proxyConfig=proxy.config.json",
    "ds-api": "npm run ds-api:create-dist && npm run ds-api:download && npm run ds-api:extract && npm run ds-api:openapi-gen",
    "ds-api:create-dist": "mkdir -p tools/openapi/dist && mkdir -p tools/openapi/src",
    "ds-api:download": "cp C:/Users/Asus/Desktop/java-angular-project/delivery-system/delivery-system-api/target/deliverysystem-1.0.0.jar ./tools/openapi/dist && cp C:/Users/Asus/Desktop/java-angular-project/delivery-system/delivery-system-api/target/openapi.json ./tools/openapi/src",
    "ds-api:extract": "node ./tools/openapi/src/openapi.json 1.0.0",
    "ds-api:openapi-gen": "./node_modules/.bin/ng-openapi-gen -i ./tools/openapi/src/openapi.json -o src/ds-api/src --ignoreUnusedModels=false"
  },
  "private": true,
  "dependencies": {
    "@angular/common": "^16.2.0",
    "@angular/compiler": "^16.2.0",
    "@angular/core": "^16.2.0",
    "@angular/forms": "^16.2.0",
    "@angular/platform-browser": "^16.2.0",
    "@angular/platform-browser-dynamic": "^16.2.0",
    "@angular/router": "^16.2.0",
    "@auth0/angular-jwt": "^5.2.0",
    "@costlydeveloper/ngx-awesome-popup": "^3.2.2",
    "@fullcalendar/angular": "^6.1.10",
    "@fullcalendar/core": "^6.1.10",
    "@fullcalendar/daygrid": "^6.1.10",
    "@fullcalendar/interaction": "^6.1.10",
    "@fullcalendar/timegrid": "^6.1.10",
    "@ng-bootstrap/ng-bootstrap": "^15.1.2",
    "@ng-select/ng-select": "^11.0.0",
    "bootstrap": "^5.3.2",
    "bootstrap-icons": "^1.11.2",
    "chart.js": "^3.9.1",
    "date-fns": "^4.1.0",
    "flatpickr": "^4.6.13",
    "net": "^1.0.2",
    "ng-openapi-gen": "^0.52.0",
    "ng2-charts": "^3.1.2",
    "ngx-bootstrap": "^11.0.2",
    "ngx-toastr": "^19.0.0",
    "openapi3-ts": "^3.0.0",
    "quill": "^2.0.0",
    "rxjs": "~7.8.0",
    "sockjs-client": "1.6.1",
    "stompjs": "^2.3.3",
    "tslib": "^2.3.0",
    "zone.js": "~0.13.0"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^16.2.14",
    "@angular/cli": "^16.2.14",
    "@angular/compiler-cli": "^16.2.0",
    "@fullhuman/postcss-purgecss": "^7.0.2",
    "@types/jasmine": "~4.3.0",
    "@types/sockjs-client": "^1.5.4",
    "@types/stompjs": "^2.3.9",
    "jasmine-core": "~4.6.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "typescript": "~5.1.3"
  }
}
